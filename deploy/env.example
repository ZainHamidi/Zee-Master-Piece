# Server settings: /opt/zee/.env on the server (owner-only, chmod 600). Never commit the real one.
# After changing it, apply with: zee up -d

MONGODB_DB=zee-masterpiece
# Set once, before the first start: MongoDB creates its users from these on first boot only.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=zee
MONGO_APP_PASSWORD=

# The live address, e.g. https://example.com (used in password-reset emails).
SITE_URL=
# Password-reset emails (resend.com → API Keys). Without a key, reset links go to the app log.
RESEND_API_KEY=
# Needs the domain verified in Resend, e.g. ZEE Masterpiece <hello@example.com>
RESEND_FROM=
