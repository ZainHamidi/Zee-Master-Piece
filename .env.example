# Copy this file to .env.local and fill it in. See MONGODB_SETUP.md.
# These stay on the server: none of them are ever sent to visitors' browsers.

# MongoDB Atlas → your cluster → Connect → Drivers. Put your database user's password in place of <db_password>.
MONGODB_URI=mongodb+srv://zee-admin:<db_password>@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=zee-masterpiece

# Password-reset emails (resend.com → API Keys). Leave empty locally: reset links are printed in the terminal instead.
RESEND_API_KEY=
# RESEND_FROM=ZEE Masterpiece <hello@yourdomain.com>

# Your live address, used in password-reset links. Leave empty locally.
SITE_URL=
